---
/**
 * PAGE CONTACT — titre, texte et étiquettes de liens à gauche, formulaire à droite.
 * Le formulaire est envoyé par public/contact.php (script PHP du serveur, qui m'envoie un e-mail par SMTP ; les identifiants restent hors du dépôt).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Tag from '@/components/Tag.astro';
import AsciiEtoile from '@/components/AsciiEtoile.astro';
import { SITE } from '@/data/site';

const liens = [
  { nom: 'E-mail @', href: `mailto:${SITE.email}`, ombre: 'bleu', tilt: -3 },
  { nom: 'LinkedIn ↗', href: 'https://www.linkedin.com/in/laura-bailly-0a3b15345/', ombre: 'rose', tilt: 3 },
  { nom: 'Behance ↗', href: 'https://www.behance.net/laurabailly', ombre: 'bleu', tilt: -2 },
  { nom: 'Instagram ↗', href: 'https://www.instagram.com/laurablly/', ombre: 'rose', tilt: 4 },
];
---

<BaseLayout
  titre="Contact"
  description="Contactez Laura Bailly pour un stage, une alternance ou un projet : formulaire, e-mail, LinkedIn et Behance."
>
  <section class="contact container" aria-labelledby="contact-titre">
    <AsciiEtoile class="contact__ascii" />

    <div class="contact__grid">
      <div class="contact__texte">
        <Tag as="h1" id="contact-titre" inclinaison={-4}>Contact</Tag>
        <p class="contact__titre" aria-hidden="true">Parlons de ton <span>projet.</span></p>
        <p class="contact__lead">Je cherche un stage en design et communication. Écris-moi ici ou retrouve-moi sur mes réseaux.</p>
        <ul class="contact__liens" aria-label="Mes liens">
          {liens.map((l) => (
            <li>
              <a
                class:list={['etiquette', `etiquette--${l.ombre}`]}
                style={`--tilt:${l.tilt}deg`}
                href={l.href}
                target={l.href.startsWith('http') ? '_blank' : undefined}
                rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >{l.nom}{l.href.startsWith('http') && <span class="sr-only"> (nouvel onglet)</span>}</a>
            </li>
          ))}
        </ul>
      </div>

      <section class="carte" aria-labelledby="form-titre">
        <h2 id="form-titre">Nouveau message</h2>
        <p class="form__status" role="status" data-status hidden></p>
  
          <form class="form" action="/contact.php" method="post" data-form>
            <div class="duo-champs">
            <div class="field">
              <label for="nom">Ton nom <span aria-hidden="true">*</span></label>
              <input id="nom" name="nom" type="text" autocomplete="name" required maxlength="100" />
            </div>
            <div class="field">
              <label for="email">Ton e-mail <span aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" required maxlength="150" />
            </div>
            </div>
            <div class="field">
              <label for="sujet">Sujet</label>
              <select id="sujet" name="sujet">
                <option>Proposition de stage</option>
                <option>Projet / collaboration</option>
                <option>Autre</option>
              </select>
            </div>
            <div class="field">
              <label for="message">Ton message <span aria-hidden="true">*</span></label>
              <textarea id="message" name="message" rows="4" required minlength="10" maxlength="3000"></textarea>
            </div>
            <!-- Piège à robots : champ invisible pour les humains -->
            <div class="hp" aria-hidden="true">
              <label for="site">Ne pas remplir</label>
              <input id="site" name="site" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <p class="form__rgpd">
              Tes informations servent uniquement à te répondre. Elles ne sont pas stockées sur le site :
              ton message m’est envoyé par e-mail, via Gmail (voir la <a href="/mentions-legales/#confidentialite">politique de confidentialité</a>).
            </p>
            <button type="submit" class="btn btn--bleu form__btn"><span class="ab" aria-hidden="true">A</span> Envoyer</button>
          </form>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { position: relative; padding-block: clamp(2rem, 4vw, 3.5rem) var(--section); }
  :global(.contact__ascii) { position: absolute; left: -6%; bottom: 2%; width: min(40vw, 520px); color: #8fb0e8; opacity: 0.3; rotate: -10deg; pointer-events: none; }
  .contact__grid { position: relative; display: grid; align-items: center; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 4vw, 3.5rem); }
  .contact__titre { margin: clamp(1.8rem, 4vw, 3rem) 0 0; max-width: 9ch; font-family: var(--font-title); font-weight: 700; font-size: clamp(2.8rem, 1rem + 6vw, 7rem); line-height: 1; letter-spacing: -0.02em; color: #fff; text-wrap: balance; }
  .contact__titre span { color: var(--pink); }
  .contact__lead { margin: 1.6rem 0 0; max-width: 40ch; font-size: var(--fs-lead); line-height: 1.35; color: rgb(255 255 255 / 0.92); }
  .contact__liens { display: flex; flex-wrap: wrap; gap: 1.4rem 1rem; margin: clamp(2rem, 4vw, 3rem) 0 0; padding: 0; list-style: none; }

  /* Même étiquette que partout sur le site : blanche, penchée, ombre pleine décalée */
  .etiquette { display: inline-block; padding: 0.35em 0.85em 0.4em; background: var(--white); color: #000; text-decoration: none; font-family: var(--font-title); font-weight: 700; line-height: 1.05; font-size: clamp(1.1rem, 0.85rem + 0.8vw, 1.6rem); transform: rotate(var(--tilt, -3deg)); box-shadow: 7px 7px 0 var(--blue); transition: transform 0.25s var(--ease-pop), box-shadow 0.25s var(--ease-pop); }
  .etiquette--rose { box-shadow: 7px 7px 0 var(--pink-deep); }
  .etiquette:hover, .etiquette:focus-visible { transform: rotate(0deg) translate(-2px, -4px); box-shadow: 11px 11px 0 var(--blue); }
  .etiquette--rose:hover, .etiquette--rose:focus-visible { box-shadow: 11px 11px 0 var(--pink-deep); }
  .etiquette:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }

  /* Carte du formulaire */
  .carte { padding: clamp(1.2rem, 2.2vw, 1.8rem); background: var(--white); border-radius: var(--radius-card); box-shadow: clamp(10px, 1.4vw, 15px) clamp(10px, 1.4vw, 15px) 0 var(--blue); color: #000; }
  .carte h2 { font-family: var(--font-title); font-weight: 700; font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.2rem); margin-bottom: 0.8rem; }
  .form { display: flex; flex-direction: column; gap: 0.8rem; }
  .duo-champs { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
  .duo-champs .field { min-width: 0; }
  .field { display: flex; flex-direction: column; gap: 0.25rem; }
  .field label { font-weight: 700; }
  .field input, .field select, .field textarea { width: 100%; padding: 0.55rem 0.8rem; border: 2px solid #000; border-radius: 8px; background: #f6fafc; color: #000; font: inherit; font-size: 1rem; }
  .field input:focus, .field select:focus, .field textarea:focus { outline: 3px solid var(--blue); outline-offset: 0; background: var(--white); }
  .hp { position: absolute; left: -9999px; }
  .form__rgpd { font-size: 0.78rem; line-height: 1.35; color: #3d424b; }
  .form__btn { align-self: flex-start; margin-top: 0.3rem; }
  .ab { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--white); color: var(--blue); font-size: 0.9rem; }
  .form__alt { font-size: 0.95rem; }
  .form__status { margin: 0 0 1rem; padding: 0.8rem 1rem; border-left: 6px solid #2fb37a; background: #e7f8ef; font-weight: 700; }
  .form__status.is-error { border-color: #d64545; background: #fdecec; }

  @media (max-width: 860px) { .contact__grid { grid-template-columns: 1fr; } .duo-champs { grid-template-columns: 1fr; } .contact__titre { max-width: none; } }
</style>

<script>
  // Affiche le message de confirmation renvoyé par contact.php (?envoi=ok / ?envoi=erreur)
  const status = document.querySelector<HTMLElement>('[data-status]');
  const envoi = new URLSearchParams(location.search).get('envoi');
  if (status && envoi) {
    status.hidden = false;
    if (envoi === 'ok') {
      status.textContent = 'Merci, ton message est bien parti ! Je te réponds au plus vite.';
    } else {
      status.classList.add('is-error');
      status.textContent = 'Oups, le message n’a pas pu être envoyé. Vérifie les champs ou écris-moi directement par e-mail.';
    }
    status.scrollIntoView({ block: 'center' });
  }
</script>
