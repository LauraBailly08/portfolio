---
/**
 * PAGE D'ACCUEIL
 * 1. Hero : qui je suis + ce que je cherche (compris avant de scroller)
 * 2. Carrousel 3DS des 3 projets
 * 3. À propos (résumé) sur fond rose
 * 4. Appel à l'action : CV / contact
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Tag from '@/components/Tag.astro';
import Carousel3DS from '@/components/Carousel3DS.astro';
import CtaBulle from '@/components/CtaBulle.astro';
import heroVisuel from '@/assets/decor/hero-visuel.png';
import exclamation from '@/assets/decor/exclamation-pixel.png';
import cartouche from '@/assets/decor/cartouche-accueil.png';
import vagues from '@/assets/decor/vagues.png';
import etoile from '@/assets/decor/etoile-ascii.png';

const projets = (await getCollection('projets')).sort((a, b) => a.data.ordre - b.data.ordre);
---

<BaseLayout>
  <!-- 1. HERO -->
  <section class="hero" aria-labelledby="hero-titre">
    <div class="hero__text">
      <Tag as="h1" id="hero-titre" taille="xl" inclinaison={-3}>Designer - Communication</Tag>
      <p class="hero__lead">
        Moi c’est <strong>Laura Bailly</strong>, étudiante en 2<sup>e</sup> année de BUT MMI.
        Je crée des interfaces et des identités visuelles entre design, code et art digital,
        et je cherche <strong>un stage</strong>.
      </p>
      <Tag as="p" taille="m" inclinaison={1} class="hero__cta">
        <a href="#projets">Voir mes projets</a>
      </Tag>
    </div>
    <Image
      src={heroVisuel}
      alt="Photo de Laura Bailly entourée de fenêtres de logiciel « Designer ?!! », « Communication », « UI-UX »"
      class="hero__visual"
      widths={[600, 1000, 1400, 2000]}
      sizes="(max-width: 760px) 100vw, 70vw"
      loading="eager"
      fetchpriority="high"
    />
  </section>

  <!-- 2. PROJETS -->
  <section id="projets" class="projets container" aria-labelledby="projets-titre">
    <Image src={exclamation} alt="" aria-hidden="true" class="projets__exclam" width={170} />
    <h2 id="projets-titre" class="sr-only">Mes projets</h2>
    <Carousel3DS projets={projets} titreId="projets-titre" />
    <p class="projets__all">
      <a href="/projets/">Tous les projets en détail →</a>
    </p>
  </section>

  <!-- 3. À PROPOS -->
  <section class="about" aria-labelledby="about-titre">
    <Image src={vagues} alt="" aria-hidden="true" class="about__waves" widths={[800, 1436]} sizes="100vw" />
    <Image src={etoile} alt="" aria-hidden="true" class="about__ascii" widths={[400, 774]} sizes="45vw" />
    <div class="about__inner container">
      <Tag as="h2" id="about-titre" inclinaison={-6}>À propos de moi</Tag>
      <div class="about__grid">
        <Image
          src={cartouche}
          alt="Cartouche de jeu « Laura Bailly » avec ma photo"
          class="about__cartouche"
          widths={[400, 834]}
          sizes="(max-width: 760px) 80vw, 420px"
        />
        <div class="about__text">
          <p class="about__lead">Designer, communication et passionnée par l’univers de l’art digital</p>
          <p>
            Je suis actuellement en deuxième année de BUT MMI, où je continue de développer
            mes compétences et ma curiosité.
          </p>
          <a class="about__more" href="/a-propos/">Voir plus <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <p class="about__keywords" aria-label="Mes domaines : design, code, visuel, UI">design&nbsp;&nbsp; code&nbsp;&nbsp; visuel&nbsp;&nbsp; ui</p>
    </div>
  </section>

  <!-- 4. CV / CONTACT -->
  <CtaBulle />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    align-items: center;
    max-width: 1440px;
    margin-inline: auto;
    padding: clamp(2.5rem, 5vw, 4.5rem) 0 clamp(2rem, 4vw, 3rem) clamp(1.25rem, 6vw, 6rem);
    min-height: min(78vw, 1000px);
  }
  .hero__text {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.8rem, 3.5vw, 3rem);
  }
  .hero__lead {
    max-width: 30ch;
    font-size: var(--fs-lead);
    line-height: 1.35;
  }
  .hero__lead strong {
    color: var(--pink);
  }
  .hero__cta {
    font-family: var(--font-body);
  }
  .hero__cta a {
    text-decoration: none;
  }
  .hero__cta a:hover {
    color: var(--blue);
  }
  .hero__cta a::after {
    content: '';
    position: absolute;
    inset: 0; /* toute l'étiquette est cliquable */
  }
  :global(.hero__cta) {
    transition: transform 0.25s var(--ease-pop);
  }
  :global(.hero__cta:hover) {
    transform: rotate(-2deg) translateY(-4px);
  }
  .hero__visual {
    width: 118%;
    max-width: none;
    margin-left: -18%;
    height: auto;
  }

  /* ---------- Projets ---------- */
  .projets {
    position: relative;
    padding-block: clamp(2rem, 5vw, 4rem) var(--section);
  }
  .projets__exclam {
    position: absolute;
    left: 0;
    top: -2rem;
    width: clamp(70px, 10vw, 170px);
    height: auto;
    rotate: -10deg;
  }
  .projets__all {
    margin-top: 1.5rem;
    text-align: center;
  }
  .projets__all a {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 1.25rem;
    text-underline-offset: 6px;
  }

  /* ---------- À propos ---------- */
  .about {
    position: relative;
    overflow: hidden;
    background: var(--pink-light);
    color: #000;
    padding-block: var(--section);
  }
  .about__waves {
    position: absolute;
    inset: auto 0 0 auto;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .about__ascii {
    position: absolute;
    right: -4%;
    top: -3%;
    width: min(54vw, 774px);
    opacity: 0.6;
    filter: brightness(0.9) sepia(1) hue-rotate(300deg) saturate(1.6);
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .about__inner {
    position: relative;
  }
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .about__cartouche {
    width: 100%;
    max-width: 480px;
    height: auto;
    filter: drop-shadow(0 12px 18px rgb(0 0 0 / 0.25));
  }
  .about__text {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    font-size: clamp(1.15rem, 0.9rem + 1vw, 2.25rem);
    line-height: 1.3;
  }
  .about__lead {
    font-weight: 700;
    font-size: clamp(1.05rem, 0.9rem + 0.6vw, 2rem);
  }
  .about__more {
    align-self: flex-end;
    display: inline-flex;
    gap: 0.6rem;
    margin-top: 1rem;
    padding: 0.5rem 1.2rem;
    background: var(--white);
    box-shadow: 6px 6px 0 var(--blue);
    font-weight: 700;
    font-size: 1.15rem;
    text-decoration: none;
    transition: transform 0.2s var(--ease-pop);
  }
  .about__more:hover {
    transform: translate(-3px, -3px);
  }
  .about__keywords {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    font-family: var(--font-mono);
    font-size: clamp(1.3rem, 0.8rem + 2vw, 3.125rem);
    text-align: center;
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      padding-right: clamp(1.25rem, 6vw, 6rem);
    }
    .hero__visual {
      width: 112%;
      margin: -2rem 0 0 -6%;
    }
    .about__grid {
      grid-template-columns: 1fr;
    }
    .about__cartouche {
      max-width: 340px;
      margin-inline: auto;
    }
  }
</style>
