---
/**
 * PAGE D'ACCUEIL
 * 1. Hero : qui je suis + ce que je cherche (compris avant de scroller)
 * 2. Carrousel 3DS des 3 projets
 * 3. À propos (résumé) sur fond rose
 * 4. Appel à l'action : CV / contact
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Tag from '@/components/Tag.astro';
import Carousel3DS from '@/components/Carousel3DS.astro';
import CtaBulle from '@/components/CtaBulle.astro';
import heroFond from '@/assets/hero/fond-v3.png';
import trait1 from '@/assets/hero/trait-1.png';
import trait2 from '@/assets/hero/trait-2.png';
import trait3 from '@/assets/hero/trait-3.png';
import trait4 from '@/assets/hero/trait-4.png';
import fen1 from '@/assets/hero/fenetre-1.png';
import fen2 from '@/assets/hero/fenetre-2.png';
import fen3 from '@/assets/hero/fenetre-3.png';
import fen4 from '@/assets/hero/fenetre-4.png';
import fen5 from '@/assets/hero/fenetre-5.png';
import fen6 from '@/assets/hero/fenetre-6.png';
import exclamation from '@/assets/decor/exclamation-pixel.png';
import cartouche from '@/assets/decor/cartouche-accueil.png';
import vagues from '@/assets/decor/vagues.png';
import etoile from '@/assets/decor/etoile-ascii.png';

// Fenêtres du hero qui « poppent » comme des pop-ups de virus à l'arrivée sur le site.
// Découpées dans l'ancienne image hero-visuel.png : x / y / w en % de l'image de fond, d = délai d'apparition (s).
// fixe = toujours affichée, sans animation (le bloc-notes cache la coupe de la photo au niveau des jambes).
// Le fond (fond-v3.png) a été reconstitué avec les calques Figma (photo + courbes) : aucun trou sous les fenêtres,
// et les cadres / traits bleus de sélection en sont retirés : ils « poppent » aussi (liste traits ci-dessous).
const fenetres = [
  { img: fen1, x: 86.959, y: 22.725, w: 8.462, d: 0.55 },
  { img: fen2, x: 10.602, y: 30.554, w: 13.041, d: 0.75 },
  { img: fen3, x: 69.338, y: 37.57, w: 18.118, d: 0.9 },
  { img: fen4, x: 41.264, y: 50.076, w: 10.453, d: 1.1 },
  { img: fen5, x: 69.935, y: 70.92, w: 21.503, d: 0, fixe: true },
  { img: fen6, x: 46.441, y: 64.616, w: 14.833, d: 1.45 },
];

// Cadres et traits bleus de sélection : chacun surgit juste avant / avec la fenêtre à laquelle il est relié.
const traits = [
  { img: trait4, x: 61.075, y: 69.039, w: 18.616, d: 0.6 }, // ligne vers le bloc-notes
  { img: trait2, x: 81.483, y: 50.686, w: 5.724, d: 0.85 }, // ligne sous « Communication »
  { img: trait1, x: 41.961, y: 25.114, w: 19.612, d: 0.95 }, // cadre autour de la tête + ligne
  { img: trait3, x: 41.513, y: 69.039, w: 28.621, d: 1.35 }, // rectangle autour de « UI-UX »
];

const projets = (await getCollection('projets')).sort((a, b) => a.data.ordre - b.data.ordre);
---

<BaseLayout>
  <!-- 1. HERO -->
  <section class="hero" aria-labelledby="hero-titre">
    <div class="hero__text">
      <!-- Une seule étiquette compacte (comme la maquette), deux lignes sans tiret orphelin -->
      <Tag as="h1" id="hero-titre" taille="m" inclinaison={-3} class="hero__title">Designer<br />Communication</Tag>
      <p class="hero__lead">
        Moi c’est <strong>Laura Bailly</strong>, étudiante en 2<sup>e</sup> année de BUT MMI.
        Je crée des interfaces et des identités visuelles entre design, code et art digital,
         je cherche actuellement <strong>un stage</strong>.
      </p>
      <Tag as="p" taille="m" inclinaison={1} class="hero__cta">
        <a href="#projets">Voir mes projets <span aria-hidden="true">↓</span></a>
      </Tag>
    </div>
    <div class="hero__stage">
      <Image
        src={heroFond}
        alt="Photo de Laura Bailly entourée de fenêtres de logiciel « Designer ?!! », « Communication », « UI-UX »"
        class="hero__visual"
        widths={[600, 1000, 1400, 2000]}
        sizes="(max-width: 760px) 100vw, 70vw"
        loading="eager"
        fetchpriority="high"
      />
      {traits.map((t) => (
        <Image
          src={t.img}
          alt=""
          aria-hidden="true"
          class="hero__popup"
          style={`left:${t.x}%;top:${t.y}%;width:${t.w}%;--d:${t.d}s`}
          widths={[300, 600]}
          sizes="25vw"
          loading="eager"
        />
      ))}
      {fenetres.map((f) => (
        <Image
          src={f.img}
          alt=""
          aria-hidden="true"
          class:list={['hero__popup', { 'hero__popup--fixe': f.fixe }]}
          style={`left:${f.x}%;top:${f.y}%;width:${f.w}%;--d:${f.d}s`}
          widths={[200, 400]}
          sizes="20vw"
          loading="eager"
        />
      ))}
    </div>
  </section>

  <!-- 2. PROJETS -->
  <section id="projets" class="projets container" aria-labelledby="projets-titre">
    <Image src={exclamation} alt="" aria-hidden="true" class="projets__exclam" width={170} />
    <h2 id="projets-titre" class="sr-only">Mes projets</h2>
    <Carousel3DS projets={projets} titreId="projets-titre" />
    <p class="projets__all">
      <a href="/projets/">Tous les projets en détail →</a>
    </p>
  </section>

  <!-- 3. À PROPOS -->
  <section class="about" aria-labelledby="about-titre">
    <Image src={vagues} alt="" aria-hidden="true" class="about__waves" widths={[800, 1436]} sizes="100vw" />
    <Image src={etoile} alt="" aria-hidden="true" class="about__ascii" widths={[400, 774]} sizes="45vw" />
    <div class="about__inner container">
      <Tag as="h2" id="about-titre" inclinaison={-6}>À propos de moi</Tag>
      <div class="about__grid">
        <Image
          src={cartouche}
          alt="Cartouche de jeu « Laura Bailly » avec ma photo"
          class="about__cartouche"
          widths={[400, 834]}
          sizes="(max-width: 760px) 80vw, 420px"
        />
        <div class="about__text">
          <p class="about__lead">Designer, communication et passionnée par l’univers de l’art digital</p>
          <p>
            Je suis actuellement en deuxième année de BUT MMI, où je continue de développer
            mes compétences et ma curiosité.
          </p>
          <a class="btn about__more" href="/a-propos/">En savoir plus <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <p class="about__keywords" aria-label="Mes domaines : design, code, visuel, UI">design · code · visuel · ui</p>
    </div>
  </section>

  <!-- 4. CV / CONTACT -->
  <CtaBulle />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: grid;
    /* la colonne de texte fait au moins la largeur des étiquettes : l'image ne peut pas passer dessous */
    grid-template-columns: minmax(min-content, 0.85fr) minmax(0, 1.5fr);
    column-gap: clamp(1rem, 3vw, 3rem);
    align-items: center;
    padding: clamp(2.5rem, 5vw, 4.5rem) 0 clamp(2rem, 4vw, 3rem) var(--edge);
    min-height: min(70vw, 900px);
  }
  .hero__text {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.8rem, 3.5vw, 3rem);
  }
  /* sélecteur renforcé : doit passer devant la taille « m » définie dans Tag.astro */
  :global(.tag.tag--m.hero__title) {
    font-size: clamp(2.2rem, 1rem + 3.2vw, 4.25rem);
  }
  .hero__lead {
    max-width: 30ch;
    font-size: var(--fs-lead);
    line-height: 1.35;
  }
  .hero__lead strong {
    color: var(--pink);
  }
  /* L'étiquette est rendue par le composant Tag : ses classes doivent être ciblées avec :global(),
     sinon le style n'est pas appliqué (c'est ce qui laissait le lien souligné). */
  :global(.hero__cta) {
    font-family: var(--font-body);
  }
  :global(.tag.tag--m.hero__cta) {
    font-size: clamp(1.15rem, 0.85rem + 0.9vw, 1.8rem); /* bouton nettement plus petit que le titre */
    --shadow-offset: 8px;
  }
  :global(.hero__cta) a {
    color: #000;
    text-decoration: none;
  }
  :global(.hero__cta) a:hover {
    color: var(--blue-glow);
  }
  :global(.hero__cta) a::after {
    content: '';
    position: absolute;
    inset: 0; /* toute l'étiquette est cliquable */
  }
  :global(.hero__cta) {
    transition: transform 0.25s var(--ease-pop);
  }
  :global(.hero__cta:hover) {
    transform: rotate(-2deg) translateY(-4px);
  }
  /* Scène du hero : le fond (photo + courbes) puis les fenêtres posées par-dessus, au pixel près */
  .hero__stage {
    position: relative;
    /* commence après la colonne de texte (plus rien sous le titre) et déborde un peu à droite */
    width: 112%;
  }
  .hero__visual {
    width: 100%;
    height: auto;
    animation: hero-fond 0.5s ease-out both;
  }
  .hero__popup {
    position: absolute;
    height: auto;
    max-width: none;
    animation: popup 0.42s var(--d, 0.6s) both;
  }
  .hero__popup--fixe {
    animation: hero-fond 0.5s ease-out both; /* arrive en même temps que la photo */
  }
  @keyframes hero-fond {
    from { opacity: 0; }
  }
  /* Pop-up façon virus : apparition brutale, rebond, petit tremblement */
  @keyframes popup {
    0% { opacity: 0; transform: scale(0.3); }
    1% { opacity: 1; }
    45% { transform: scale(1.12); }
    60% { transform: scale(0.96) translate(-3px, 2px); }
    72% { transform: scale(1.02) translate(3px, -2px); }
    84% { transform: translate(-2px, 0); }
    100% { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__visual,
    .hero__popup {
      animation: none;
    }
  }

  /* ---------- Projets ---------- */
  .projets {
    position: relative;
    padding-block: clamp(2rem, 5vw, 4rem) var(--section);
  }
  .projets__exclam {
    position: absolute;
    left: 0;
    top: clamp(-9rem, -9vw, -4rem); /* remonté : ne touche plus la bulle du carrousel */
    width: clamp(70px, 10vw, 170px);
    height: auto;
    rotate: -10deg;
  }
  .projets__all {
    margin-top: 1.5rem;
    text-align: center;
  }
  .projets__all a {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 1.25rem;
    text-underline-offset: 6px;
  }

  /* ---------- À propos ---------- */
  .about {
    position: relative;
    overflow: hidden;
    background: var(--pink-light);
    color: #000;
    padding-block: var(--section);
  }
  .about__waves {
    position: absolute;
    inset: auto 0 0 auto;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .about__ascii {
    position: absolute;
    right: -4%;
    top: -3%;
    width: min(54vw, 774px);
    opacity: 0.6;
    filter: brightness(0.9) sepia(1) hue-rotate(300deg) saturate(1.6);
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .about__inner {
    position: relative;
  }
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .about__cartouche {
    width: 100%;
    max-width: 480px;
    height: auto;
    filter: drop-shadow(0 12px 18px rgb(0 0 0 / 0.25));
  }
  .about__text {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    max-width: 34rem;
    font-size: clamp(1.1rem, 0.95rem + 0.6vw, 1.6rem);
    line-height: 1.4;
  }
  .about__lead {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(1.4rem, 1rem + 1.4vw, 2.4rem);
    line-height: 1.15;
  }
  .about__more {
    align-self: flex-start;
    margin-top: 0.5rem;
  }
  .about__keywords {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    font-family: var(--font-mono);
    font-size: clamp(1.1rem, 0.8rem + 2vw, 3.125rem);
    text-align: center;
    word-spacing: 0.4em;
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      padding-right: var(--edge);
      min-height: 0;
    }
    .hero__stage {
      width: 112%;
      margin: 1rem 0 0 -6%; /* ne remonte plus sur le bouton */
    }
    .about__grid {
      grid-template-columns: 1fr;
    }
    .about__cartouche {
      max-width: 340px;
      margin-inline: auto;
    }
    .about__keywords {
      font-size: 1rem;
      word-spacing: 0;
      white-space: nowrap;
    }
  }
</style>
