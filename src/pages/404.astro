---
/** Page 404 — servie automatiquement par l'hébergement quand une page n'existe pas. */
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Tag from '@/components/Tag.astro';
---

<BaseLayout titre="Page introuvable">
  <!-- Mise en page avec les utilitaires Tailwind (même rendu qu'avant) -->
  <section class="container flex flex-col items-start gap-10 py-[clamp(4rem,10vw,9rem)]">
    <Tag as="h1">Erreur 404</Tag>
    <p class="text-(length:--fs-lead)">Il n’y a aucune cartouche dans ce lecteur… Cette page n’existe pas.</p>
    <Tag as="p" taille="m" inclinaison={2}><a class="no-underline" href="/">Retour au menu</a></Tag>
  </section>
</BaseLayout>

