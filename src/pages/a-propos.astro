---
/**
 * PAGE À PROPOS — écrite à la première personne (exigence du cahier des charges).
 * Cartouche photo + bulle BD, compétences en « dossiers », inspirations en jaquettes.
 */
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Tag from '@/components/Tag.astro';
import cartouche from '@/assets/decor/cartouche-accueil.png'; // même jaquette que sur l'accueil (photo sur fond blanc)
import AsciiEtoile from '@/components/AsciiEtoile.astro';
import figma from '@/assets/skills/figma.png';
import affinity from '@/assets/skills/affinity.png';
import astro from '@/assets/skills/astro.png';
import vscode from '@/assets/skills/vscode.png';
import gemini from '@/assets/skills/gemini.png';
import canva from '@/assets/skills/canva.png';
import insp1 from '@/assets/inspirations/inspiration-1.png';
import insp2 from '@/assets/inspirations/inspiration-2.png';
import insp3 from '@/assets/inspirations/inspiration-3.png';
import insp4 from '@/assets/inspirations/inspiration-4.png';
import insp5 from '@/assets/inspirations/inspiration-5.png';
import insp6 from '@/assets/inspirations/inspiration-6.png';

const skills = [
  { nom: 'Figma', desc: 'Maquettes & prototypes', img: figma },
  { nom: 'Affinity', desc: 'Identité visuelle & illustration', img: affinity },
  { nom: 'Astro', desc: 'Sites & intégration', img: astro },
  { nom: 'VS Code', desc: 'Code & développement', img: vscode },
  { nom: 'IA générative', desc: 'Idées & recherche', img: gemini },
  { nom: 'Canva', desc: 'Posts & supports', img: canva },
];

// Chaque jaquette se retourne au survol (ou au clic / au clavier) et montre son thème au dos.
// theme = titre au dos ; description = ce qu'on voit sur l'image (sert aussi de texte alternatif).
const inspirations = [
  { img: insp1, theme: 'Concert', description: 'Un artiste seul sur scène, sous un faisceau de lumière, en noir et blanc.' },
  { img: insp2, theme: 'Paysage', description: 'Une vallée de montagne et ses chalets sous un ciel nuageux.' },
  { img: insp3, theme: 'Cybertech', description: 'Un collage d’objets tech des années 2000 : ordinateur rose, Tamagotchi, coque transparente.' },
  { img: insp4, theme: 'Esport', description: 'La cérémonie d’un tournoi d’esport, avec ses écrans rouges « Champions ».' },
  { img: insp5, theme: 'Photographie', description: 'Une rue pavée de Montmartre et son enseigne en fer forgé.' },
  { img: insp6, theme: 'Jeux vidéo', description: 'Un setup de jeu dans le noir, avec une Nintendo 3DS allumée.' },
];

// Le dos de chaque jaquette est découpé avec la silhouette de l'image (masque CSS).
// On utilise une version WebP légère (600 px) au lieu du PNG d'origine : la page perd environ 2,5 Mo.
const masques = await Promise.all(inspirations.map((i) => getImage({ src: i.img, width: 600, format: 'webp' })));
---

<BaseLayout
  titre="À propos"
  description="Je m’appelle Laura Bailly, j’ai 20 ans et je suis en 2e année de BUT MMI. Design, communication, art digital : découvrez mon parcours, mes outils et mes inspirations."
>
  <!-- PRÉSENTATION -->
  <section class="hello container" aria-labelledby="apropos-titre">
    <Tag as="h1" id="apropos-titre" inclinaison={-4}>À propos</Tag>
    <div class="hello__grid">
      <div class="hello__text">
  <p class="hello__nom" aria-hidden="true">Laura Bailly</p>
        <p class="hello__lead">
          J’ai 20 ans, je suis en deuxième année de BUT MMI et ce qui me passionne, c’est de ne jamais rester enfermée dans une seule case.
        </p>
        <p>
          J’aime imaginer, créer et voir mes idées prendre vie. Je passe facilement de la maquette
          Figma au code, et de l’identité visuelle à l’illustration : c’est ce mélange entre design,
          communication et art digital qui me plaît.
        </p>
        <p class="hello__search">
          Je suis actuellement <strong>à la recherche d’un stage</strong> en design d’interface,
          communication visuelle ou direction artistique.
        </p>
      </div>
      <div class="hello__photo">
        <Image
          src={cartouche}
          alt="Cartouche de jeu « Laura Bailly » avec ma photo"
          class="hello__cartouche"
          widths={[400, 834]}
          sizes="(max-width: 760px) 80vw, 460px"
          loading="eager"
        />
        <span class="hello__tag hello__tag--1" aria-hidden="true">20 ans</span>
        <span class="hello__tag hello__tag--2" aria-hidden="true">BUT MMI · 2e année</span>
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section class="skills container" aria-labelledby="skills-titre">
    <AsciiEtoile class="skills__ascii" />
    <Tag as="h2" id="skills-titre" ombre="rose" inclinaison={3}>Skills</Tag>
    <ol class="skills__index">
      {skills.map((s, i) => (
        <li class="skill">
          <span class="skill__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="skill__nom">{s.nom}</span>
          <span class="skill__desc">{s.desc}</span>
        </li>
      ))}
    </ol>
  </section>

  <!-- INSPIRATIONS -->
  <section class="insp container" aria-labelledby="insp-titre">
    <Tag as="h2" id="insp-titre">Inspirations</Tag>
    <ul class="insp__grid">
      {inspirations.map((i, k) => (
        <li>
          <button class="flip" type="button" aria-pressed="false" data-flip style={`--mask:url("${masques[k].src}")`}>
            <span class="flip__inner">
              <span class="flip__face flip__face--avant">
                <Image src={i.img} alt="" widths={[300, 400, 804]} sizes="(max-width: 640px) 45vw, 380px" />
              </span>
              <span class="flip__face flip__face--dos" aria-hidden="true">
                <span class="flip__ecran">
                  <span class="flip__theme">{i.theme}</span>
                </span>
              </span>
            </span>
            <span class="sr-only">{i.theme} : {i.description}</span>
          </button>
        </li>
      ))}
    </ul>
  </section>

</BaseLayout>

<style>
  .hello { container-type: inline-size; padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(3rem, 6vw, 5rem); }
  .hello__nom { margin: 0 0 0.4rem; font-family: var(--font-title); font-weight: 700; font-size: 11.4cqw; line-height: 1; letter-spacing: -0.04em; color: var(--pink); white-space: nowrap; user-select: none; }
  .hello__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); margin-top: clamp(2rem, 4vw, 3rem); }
  .hello__text { display: flex; flex-direction: column; gap: 1.5rem; max-width: 44rem; font-size: clamp(1.05rem, 0.98rem + 0.35vw, 1.3rem); line-height: 1.65; }
  .hello__lead { font-family: var(--font-title); font-weight: 700; font-size: clamp(1.3rem, 1rem + 1vw, 1.9rem); line-height: 1.25; color: #fff; }
  .hello__search { padding: 1rem 1.2rem; border-left: 6px solid var(--pink); background: rgb(255 255 255 / 0.05); }
  .hello__search strong { color: var(--pink); }
  .hello__photo { position: relative; justify-self: center; width: min(100%, 460px); margin-top: clamp(-5rem, -4vw, -1rem); }
  .hello__cartouche { display: block; width: 100%; height: auto; rotate: 5deg; filter: drop-shadow(0 18px 24px rgb(0 0 0 / 0.45)); }
  .hello__tag { position: absolute; padding: 0.3em 0.8em 0.35em; background: var(--white); color: #000; font-family: var(--font-title); font-weight: 700; line-height: 1.05; font-size: clamp(1.1rem, 0.9rem + 0.8vw, 1.6rem); white-space: nowrap; }
  .hello__tag--1 { left: -8%; top: 6%; rotate: -8deg; box-shadow: 7px 7px 0 var(--blue); }
  .hello__tag--2 { right: -4%; bottom: 6%; rotate: 4deg; box-shadow: 7px 7px 0 var(--pink-deep); }

  .skills { position: relative; padding-bottom: clamp(3rem, 6vw, 5rem); }
  :global(.skills__ascii) { position: absolute; right: -2%; top: -6%; width: min(36vw, 460px); color: #8fb0e8; opacity: 0.16; pointer-events: none; }
  .skills__index { position: relative; margin: clamp(1.8rem, 4vw, 3rem) 0 0; padding: 0; list-style: none; counter-reset: s; }
  .skill { position: relative; display: grid; grid-template-columns: 3.2rem minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; gap: 1rem 1.5rem; padding: clamp(0.8rem, 1.6vw, 1.3rem) clamp(1rem, 2vw, 2rem); isolation: isolate; }
  .skill::before { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: 18px; background: var(--pink); box-shadow: 8px 8px 0 var(--blue); opacity: 0; transform: rotate(-0.6deg) scale(0.98); transition: opacity 0.2s, transform 0.3s var(--ease-pop); }
  .skill:hover::before { opacity: 1; transform: rotate(-0.6deg) scale(1); }
  .skill__num { font-family: var(--font-mono); font-size: 1rem; }
  .skill__nom { font-family: var(--font-title); font-weight: 700; font-size: clamp(1.8rem, 1rem + 2vw, 3rem); line-height: 1; letter-spacing: -0.02em; }
  .skill__desc { font-family: var(--font-mono); font-size: clamp(0.9rem, 0.8rem + 0.3vw, 1.1rem); }
  .skill:hover { color: var(--navy); }

  .insp {
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }
  .insp__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, clamp(200px, calc((100svh - 90px) / 2.05), 460px)));
    justify-content: center;
    gap: clamp(1rem, 2vw, 1.6rem);
    margin: clamp(2.2rem, 4vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  /* ---------- Jaquette qui se retourne ---------- */
  .flip {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    aspect-ratio: 804 / 826;
  }
  .flip__inner {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Chaque face tourne séparément (plus fiable que la 3D imbriquée dans un bouton) :
     le recto passe de 0° à 180°, le verso de -180° à 0°. */
  .flip__face {
    transition: transform 0.6s var(--ease-pop);
  }
  .flip__face--avant {
    transform: perspective(1200px) rotateY(0deg);
  }
  .flip:hover .flip__face--avant,
  .flip:focus-visible .flip__face--avant,
  .flip[aria-pressed='true'] .flip__face--avant {
    transform: perspective(1200px) rotateY(180deg);
  }
  .flip:hover .flip__face--dos,
  .flip:focus-visible .flip__face--dos,
  .flip[aria-pressed='true'] .flip__face--dos {
    transform: perspective(1200px) rotateY(0deg);
  }
  .flip:focus-visible {
    outline: none;
  }
  .flip:focus-visible .flip__face--dos {
    filter: drop-shadow(0 0 0 var(--blue)) drop-shadow(0 0 4px var(--blue));
  }
  .flip__face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
  }
  .flip__face :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* dos : même silhouette de cartouche que l'image (masque), écran rose avec le thème */
  .flip__face--dos {
    transform: perspective(1200px) rotateY(-180deg);
    background: #303030;
    -webkit-mask: var(--mask) center / 100% 100% no-repeat;
    mask: var(--mask) center / 100% 100% no-repeat;
  }
  .flip__ecran {
    position: absolute;
    inset: 7.7% 9.5% 10.4% 8.6%; /* même emplacement que la photo sur le recto */
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.6rem;
    padding: 1.2rem;
    border-radius: 4px;
    background: #303030;
    color: var(--white);
    align-items: center;
    text-align: center;
  }
  .flip__theme {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(1.1rem, 0.8rem + 0.9vw, 1.7rem);
    line-height: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .flip__face {
      transition: none;
    }
  }

  @media (max-width: 760px) {
    .hello__grid { grid-template-columns: 1fr; }
    .hello__photo { width: min(80%, 320px); margin-top: 0; }
    .skill { grid-template-columns: minmax(0, 1fr); }
    .skill__num { display: none; }
    .skill__desc { grid-column: 1; }
      .insp__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>

<script>
  // Sur téléphone il n'y a pas de survol : un toucher (ou Entrée / Espace) retourne la jaquette.
  document.querySelectorAll<HTMLButtonElement>('[data-flip]').forEach((b) => {
    b.addEventListener('click', () => {
      b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
    });
  });
</script>
