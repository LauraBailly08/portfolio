---
/**
 * Pied de page — reprend le footer Figma (grand logo, liens « *projets »,
 * réseaux, étoile ASCII, étiquette « retour en haut »).
 * Amélioré : liens réellement cliquables, e-mail visible, icônes accessibles,
 * barre du bas (légal / réseaux / retour en haut) alignée sur la grille du site.
 */
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import { NAV, SITE } from '@/data/site';
import AsciiEtoile from './AsciiEtoile.astro';
import linkedin from '@/assets/icons/footer-linkedin.png';
import behance from '@/assets/icons/footer-behance.png';
import mail from '@/assets/icons/footer-mail.png';

const reseaux = [
  { nom: 'LinkedIn', href: 'https://www.linkedin.com/in/laura-bailly-0a3b15345/', img: linkedin },
  { nom: 'Behance', href: 'https://www.behance.net/laurabailly', img: behance },
  { nom: 'M’écrire un e-mail', href: `mailto:${SITE.email}`, img: mail },
];
const annee = new Date().getFullYear();
---

<footer class="footer">
  <AsciiEtoile class="footer__ascii" />

  <div class="footer__inner">
    <div class="footer__brand">
      <a class="footer__logo" href="/" aria-label="Laura Bailly — accueil">
        <Logo />
      </a>
      <p class="footer__signature">{SITE.signature}</p>
      <a class="footer__mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>

    <nav class="footer__nav" aria-label="Plan du site">
      <ul>
        {NAV.map((item) => (
          <li><a href={item.href}>*{item.label.toLowerCase()}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer__bottom">
      <ul class="footer__social" aria-label="Mes réseaux">
        {reseaux.map((r) => (
          <li>
            <a href={r.href} target={r.href.startsWith('http') ? '_blank' : undefined} rel={r.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
              <Image src={r.img} alt={r.nom} height={32} class="footer__social-icon" />
            </a>
          </li>
        ))}
      </ul>

      <div class="footer__legal">
        <p>© {annee} Laura Bailly. Tous droits réservés.</p>
        <p>
          <a href="/mentions-legales/">Mentions légales</a>
          <span aria-hidden="true">·</span>
          <a href="/mentions-legales/#confidentialite">Confidentialité</a>
        </p>
      </div>

      <a class="footer__top" href="#haut">retour en haut <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    background: var(--sky);
    color: #000;
    font-family: var(--font-title);
  }
  :global(.footer__ascii) {
    position: absolute;
    right: 4%;
    top: -8%;
    width: min(62vw, 560px);
    color: var(--blue);
    opacity: 0.28;
    pointer-events: none;
  }
  .footer__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand nav'
      'bottom bottom';
    gap: clamp(2rem, 4vw, 3.5rem) 2rem;
    padding: clamp(3rem, 6vw, 5rem) var(--edge) clamp(1.5rem, 3vw, 2.5rem);
  }
  .footer__brand {
    grid-area: brand;
  }
  .footer__logo {
    display: inline-flex;
    font-weight: 700;
    font-size: clamp(3rem, 1.5rem + 6vw, 7.5rem);
    line-height: 0.82;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .footer__signature {
    margin-top: 1.2rem;
    font-size: clamp(1.1rem, 0.9rem + 0.8vw, 1.75rem);
  }
  .footer__mail {
    display: inline-block;
    margin-top: 0.4rem;
    font-family: var(--font-body);
    font-size: 1rem;
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }
  .footer__mail:hover {
    color: var(--blue-glow);
  }
  .footer__nav {
    grid-area: nav;
    text-align: right;
  }
  .footer__nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer__nav a {
    display: inline-block;
    font-weight: 700;
    font-size: clamp(1.4rem, 1rem + 1.4vw, 2.5rem);
    line-height: 1.7;
    text-decoration: none;
    transition: color 0.2s, transform 0.2s var(--ease-pop);
  }
  .footer__nav a:hover {
    color: var(--blue-glow);
    transform: translateX(-6px);
  }

  /* Barre du bas : réseaux | mentions | retour en haut */
  .footer__bottom {
    grid-area: bottom;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 2px solid #000;
  }
  .footer__social {
    display: flex;
    gap: 1.4rem;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer__social a {
    display: block;
    transition: transform 0.2s var(--ease-pop);
  }
  .footer__social a:hover {
    transform: translateY(-4px) rotate(-6deg);
  }
  .footer__social-icon {
    height: 28px;
    width: auto;
  }
  .footer__legal {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.9rem;
  }
  .footer__legal p:last-child {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }
  .footer__legal a {
    text-underline-offset: 3px;
  }
  .footer__legal a:hover {
    color: var(--blue-glow);
  }
  .footer__top {
    justify-self: end;
    display: inline-block;
    padding: 0.7rem 1.4rem;
    background: #000;
    color: var(--white);
    font-weight: 700;
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.4rem);
    text-decoration: none;
    rotate: -6deg;
    box-shadow: 8px 8px 0 var(--blue);
    transition: rotate 0.25s var(--ease-pop), translate 0.25s var(--ease-pop), box-shadow 0.25s;
  }
  .footer__top:hover {
    rotate: -2deg;
    translate: 0 -4px;
    box-shadow: 11px 11px 0 var(--blue);
  }

  @media (max-width: 760px) {
    .footer__inner {
      grid-template-columns: 1fr;
      grid-template-areas: 'brand' 'nav' 'bottom';
    }
    .footer__nav {
      text-align: left;
    }
    .footer__bottom {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'social top'
        'legal legal';
    }
    .footer__social {
      grid-area: social;
    }
    .footer__top {
      grid-area: top;
    }
    .footer__legal {
      grid-area: legal;
      text-align: left;
    }
    .footer__legal p:last-child {
      justify-content: flex-start;
    }
  }
</style>
