---
/**
 * Fenêtre « .exe » de la section Processus (style de la maquette Figma) :
 * cadre blanc à bord noir, barre de titre bleue, ombre bleue pleine décalée.
 */
interface Props {
  fichier: string;
  titre: string;
  class?: string;
}
const { fichier, titre, class: className } = Astro.props;
---

<article class:list={['win', className]}>
  <header class="win__bar">
    <span class="win__file">{fichier}</span>
    <span class="win__btns" aria-hidden="true"><i>_</i><i>□</i><i>×</i></span>
  </header>
  <div class="win__body">
    <h3 class="win__title">{titre}</h3>
    <slot />
  </div>
</article>

<style>
  .win {
    position: relative;
    background: var(--white);
    border: 3px solid #000;
    border-radius: 18px;
    color: #000;
    box-shadow: clamp(10px, 1.8vw, 22px) clamp(10px, 1.8vw, 22px) 0 var(--blue);
    overflow: hidden;
  }
  .win__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    padding: 0.6rem 1.2rem;
    background: var(--blue);
    border-bottom: 2px solid #000;
    color: var(--white);
  }
  .win__file {
    font-size: clamp(1.1rem, 0.9rem + 0.6vw, 1.75rem);
  }
  .win__btns {
    display: flex;
    gap: 0.4rem;
    font-family: var(--font-mono);
  }
  .win__btns i {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    background: var(--white);
    border: 1.5px solid #000;
    color: #000;
    font-style: normal;
    font-size: 0.8rem;
    line-height: 1;
  }
  .win__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.4rem 1.6rem 1.8rem;
  }
  .win__title {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(1.2rem, 1rem + 0.6vw, 1.75rem);
  }
</style>
