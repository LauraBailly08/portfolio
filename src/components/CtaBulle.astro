---
/**
 * Bloc « Prêt à travailler avec moi ? » — même forme que la bulle du carrousel de l'accueil
 * (rectangle blanc aux coins arrondis + petite pointe), avec l'ombre bleue pleine décalée du site.
 * Compacte : le texte et les boutons occupent presque toute la bulle.
 * Décors : deux étoiles ASCII fixes de part et d'autre (elles grésillent seulement).
 */
import { SITE } from '@/data/site';
import AsciiEtoile from './AsciiEtoile.astro';
interface Props {
  titre?: string;
}
const { titre = 'Prêt à travailler avec moi ?' } = Astro.props;
---

<section class="cta" aria-labelledby="cta-titre">
  <div class="cta__wrap">
    <AsciiEtoile class="cta__ascii cta__ascii--grande" vivante />
    <AsciiEtoile class="cta__ascii cta__ascii--petite" vivante />

    <div class="cta__bubble">
      <h2 id="cta-titre" class="cta__title">{titre}</h2>
      <p class="cta__sub">Je cherche un stage en design et communication.</p>
      <div class="cta__actions">
        <a class="btn" href={SITE.cv} download>Mon CV <span aria-hidden="true">↓</span></a>
        <a class="btn btn--bleu" href="/contact/">Me contacter <span aria-hidden="true">→</span></a>
      </div>
      <!-- pointe, comme la bulle du carrousel -->
      <svg class="cta__tip" viewBox="0 0 36 22" aria-hidden="true"><path d="M0 0L18 19L36 0Z" /></svg>
    </div>
  </div>
</section>

<style>
  .cta {
    display: grid;
    place-items: center;
    padding: clamp(3rem, 7vw, 6rem) var(--gutter) var(--section);
    overflow: clip; /* les étoiles ne débordent pas sur les sections voisines */
  }
  .cta__wrap {
    position: relative;
    width: min(100%, 640px);
  }
  /* bulle blanche arrondie ; l'ombre (filtre) suit aussi la pointe */
  .cta__bubble {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(1.8rem, 4vw, 2.6rem) clamp(1.4rem, 4vw, 3rem);
    background: var(--white);
    border-radius: 34px;
    color: #000;
    text-align: center;
    filter: drop-shadow(14px 16px 0 var(--blue));
  }
  .cta__tip {
    position: absolute;
    left: 22%;
    bottom: -32px;
    width: 54px;
    height: 34px;
    fill: var(--white);
  }
  .cta__title {
    font-size: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    line-height: 1.1;
    text-wrap: balance;
  }
  .cta__sub {
    margin-top: 0.7rem;
    font-size: clamp(0.95rem, 0.88rem + 0.35vw, 1.2rem);
    color: #2b3445;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 1.5rem;
    margin-top: 1.6rem;
  }

  /* ---------- Étoiles ASCII (composant : sélecteurs :global) ---------- */
  :global(.cta__ascii) {
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }
  /* grande étoile rose à gauche de la bulle, à moitié cachée derrière */
  :global(.cta__ascii--grande) {
    left: -42%;
    top: 50%;
    width: 62%;
    translate: 0 -50%;
    color: var(--pink);
    opacity: 0.75;
    rotate: -12deg;
  }
  /* petite étoile bleue en haut à droite */
  :global(.cta__ascii--petite) {
    right: -30%;
    top: -20%;
    width: 34%;
    color: var(--blue);
    rotate: 14deg;
  }

  @media (max-width: 560px) {
    .cta__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 0.9rem;
      width: 100%;
    }
    :global(.cta__ascii--grande) {
      left: -30%;
      width: 80%;
      opacity: 0.4;
    }
    :global(.cta__ascii--petite) {
      right: -12%;
      top: -30%;
      width: 40%;
    }
  }
</style>
