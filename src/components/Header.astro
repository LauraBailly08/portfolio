---
/**
 * En-tête : logo cartouche « LB » (composant Logo) + onglets façon classeur (maquette Figma).
 * L'onglet de la page en cours reçoit aria-current="page" et un style actif.
 */
import { NAV } from '@/data/site';
import NavIcon from './NavIcon.astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---

<header class="header" data-header>
  <div class="header__inner">
    <a class="logo" href="/" aria-label="Laura Bailly — retour à l’accueil">
      <Logo />
    </a>

    <nav aria-label="Navigation principale">
      <ul class="tabs">
        {NAV.map((item) => (
          <li>
            <a
              class:list={['tab', { 'tab--active': isActive(item.href) }]}
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="tab__label">{item.label}</span>
              <span class="tab__icon"><NavIcon name={item.icone} /></span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // En-tête collant : il reste visible et se compacte dès qu'on défile.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    let ticking = false;
    const maj = () => {
      header.classList.toggle('is-compact', window.scrollY > 40);
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(maj); }
    }, { passive: true });
    maj();
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    overflow: clip; /* les onglets ne dépassent jamais sur la page */
    background: color-mix(in srgb, var(--navy) 70%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 0;
    color: var(--white);
    transition: box-shadow 0.3s ease;
  }
  /* Filet sous les onglets : ils reposent dessus comme des onglets de classeur (plus d'effet « coupé »). */
  .header::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 3px;
    background: var(--blue);
    z-index: 0;
  }
  .header__inner {
    position: relative;
    z-index: 1; /* logo et onglets passent par-dessus le filet */
  }
  .header.is-compact {
    box-shadow: 0 10px 28px rgb(0 0 0 / 0.35);
  }
  .header__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem var(--edge) 0;
    transition: padding 0.3s var(--ease-pop);
  }
  .header.is-compact .header__inner {
    padding-top: 0.4rem;
  }

  .logo {
    align-self: center;
    padding-bottom: 0.5rem;
    display: inline-flex;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(1.4rem, 1rem + 1.2vw, 2.5rem);
    line-height: 0.82;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--white);
    transition: font-size 0.3s var(--ease-pop);
  }
  .header.is-compact .logo {
    font-size: clamp(1.1rem, 0.8rem + 0.8vw, 1.7rem);
  }

  .tabs {
    display: flex;
    gap: clamp(0.4rem, 1vw, 0.8rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Onglets : blocs blancs nets, sans halo bleu. L'onglet actif passe en rose. */
  .tab {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.9rem 0.65rem;
    background: var(--white);
    border-radius: 12px 12px 0 0; /* onglet de classeur : accroché au bas du bandeau */
    box-shadow: 0 -2px 8px rgb(0 20 40 / 0.1);
    transform: translateY(5px);
    color: #000;
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 0.85rem + 0.3vw, 1.2rem);
    text-decoration: none;
    transition: transform 0.2s var(--ease-pop), background-color 0.2s, box-shadow 0.2s, padding 0.3s var(--ease-pop);
  }
  .header.is-compact .tab {
    padding-block: 0.35rem 0.45rem;
  }
  .tab:hover,
  .tab--active {
    transform: translateY(0);
  }
  .tab--active {
    background: var(--pink-light);
    font-weight: 700;
  }
  .tab__icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 34px;
    flex: none;
  }
  .tab__icon :global(svg) {
    max-height: 100%;
    width: auto;
  }

  @media (max-width: 720px) {
    .header__inner {
      padding: 0.6rem 1rem 0;
    }
    .tab {
      padding: 0.45rem 0.7rem 0.55rem;
    }
    .tab__icon {
      display: none;
    }
  }
  @media (max-width: 400px) {
    .tab {
      font-size: 0.85rem;
      padding: 0.4rem 0.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .header, .header__inner, .logo, .tab { transition: none; }
  }
</style>
