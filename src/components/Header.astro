---
/**
 * En-tête : logo cartouche « LB » (composant Logo) + onglets façon classeur (maquette Figma).
 * L'onglet de la page en cours reçoit aria-current="page" et un style actif.
 */
import { NAV } from '@/data/site';
import NavIcon from './NavIcon.astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---

<header class="header" data-header>
  <div class="header__inner">
    <a class="logo" href="/" aria-label="Laura Bailly — retour à l’accueil">
      <Logo />
    </a>

    <nav aria-label="Navigation principale">
      <ul class="tabs">
        {NAV.map((item) => (
          <li>
            <a
              class:list={['tab', { 'tab--active': isActive(item.href) }]}
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="tab__label">{item.label}</span>
              <span class="tab__icon"><NavIcon name={item.icone} /></span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Publie la hauteur réelle de l'en-tête (collant) : les liens d'ancre s'arrêtent juste sous lui, sans vide.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const hauteur = () => document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
    hauteur();
    new ResizeObserver(hauteur).observe(header);
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    overflow: clip; /* les onglets ne dépassent jamais sur la page */
    background: var(--navy-2); /* opaque : le contenu de la page ne transparaît pas sous l'en-tête */
    border-bottom: 0;
    color: var(--white);
  }
  .header__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem var(--edge) 0;
    border-bottom: 5px solid var(--pink-light); /* trait rose sous les onglets */
  }

  .logo {
    align-self: center;
    padding-bottom: 0.5rem;
    display: inline-flex;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(1.4rem, 1rem + 1.2vw, 2.5rem);
    line-height: 0.82;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--white);
  }

  .tabs {
    display: flex;
    gap: clamp(0.4rem, 1vw, 0.8rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Onglets : blocs blancs nets, sans halo bleu. L'onglet actif passe en rose. */
  .tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.9rem 0.65rem;
    background: var(--white);
    border-radius: 12px 12px 0 0; /* onglet de classeur : accroché au bas du bandeau */
    box-shadow: 0 -2px 8px rgb(0 20 40 / 0.1);
    color: #000;
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 0.85rem + 0.3vw, 1.2rem);
    white-space: nowrap;
    text-decoration: none;
    transition: transform 0.2s var(--ease-pop), background-color 0.2s, box-shadow 0.2s;
  }
  .tab:hover {
    transform: translateY(-4px);
  }
  /* Le troisième onglet est bleu ciel ; l'onglet actif est rose et se fond dans le trait */
  .tabs li:nth-child(3) .tab:not(.tab--active) {
    background: var(--sky);
  }
  .tab--active {
    background: var(--pink-light);
    font-weight: 700;
  }
  /* prolonge l'onglet actif sur le trait rose : il s'y fond, comme un onglet de classeur ouvert */
  .tab--active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -5px;
    height: 5px;
    background: var(--pink-light);
  }
  .tab__icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 34px;
    flex: none;
  }
  .tab__icon :global(svg) {
    max-height: 100%;
    width: auto;
  }

  @media (max-width: 720px) {
    .header__inner {
      padding: 0.6rem 1rem 0;
      border-bottom-width: 4px;
    }
    .tab--active::after {
      bottom: -4px;
      height: 4px;
    }
    .tab {
      padding: 0.45rem 0.7rem 0.55rem;
    }
    .tab__icon {
      display: none;
    }
  }
  @media (max-width: 400px) {
    .tab {
      font-size: 0.85rem;
      padding: 0.4rem 0.5rem;
    }
  }
  /* très petits écrans (320 px) : le logo et les onglets se resserrent pour tenir sur une ligne */
  @media (max-width: 380px) {
    .header__inner { gap: 0.5rem; padding-inline: 0.7rem; }
    .tabs { gap: 0.25rem; }
  }
  @media (max-width: 350px) {
    .logo { font-size: 1.1rem; }
    .tab { font-size: 0.78rem; padding: 0.35rem 0.4rem 0.45rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tab { transition: none; }
  }
</style>
