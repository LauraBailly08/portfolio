# Copie ce fichier en « .env » (jamais commité) et adapte les valeurs.
# Adresse de PocketBase : si elle est absente, le site lit les fichiers Markdown de src/content/projets/.
POCKETBASE_URL=http://127.0.0.1:8090

# Uniquement pour le script « npm run pb:seed » (compte superuser PocketBase) :
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=
